762 0 obj
<</JS(\r\n\r\n\r\n// Anark Core Script\r\n\r\n\r\n//Version : 2.7\r\n//Modified Date : 23/09/25\r\n//Modified By : Sudarshan Kumar\r\n//Changes : MScript changed to populate only view name.All views from page2 onwards will not have the inverted image.\r\n\r\ninit3D\(this\);\r\n\r\nfunction init3D\(document\) {\r\n  document.anarkCoreData = new ANARKCOREDATA\(\);\r\n  populateAnarkCoreTemplateVersion\(document\);\r\n  populateDocFields\(document\);\r\n  document.akBom = new AKBom\(document.getField\('BOMListBox'\)\);\r\n  document.akBom.populateBOMListFromPmiTable\(document\);\r\n  initializeViewCarousel\(document\);\r\n  initializePrinting\(document\);\r\n  populateDateFields\(document\);\r\n  populateAttributeValues\(document\);\r\n}\r\n\r\n\r\n// This function checks whether the input is part or assembly and returns component id\r\nfunction getCompIDBasedOnInput\(document\) {\r\n  var occurrences = document.anarkCoreData.getOccurrences\(\);\r\n  var occ;\r\n  var occurrenceToExtractNotes = "";\r\n  for \(var k = 0; k < occurrences.length; k++\) {\r\n      occ = occurrences[k];\r\n      if \(occ.typeOfEntity === "AssemblyOccurrence"\) {\r\n          occurrenceToExtractNotes = occurrences[k];\r\n          break;\r\n      }\r\n  }\r\n  if \(occurrenceToExtractNotes === ""\) {\r\n      for \(var k = 0; k < occurrences.length; k++\) {\r\n          occ = occurrences[k];\r\n          if \(occ.typeOfEntity === "PartOccurrence"\) {\r\n              occurrenceToExtractNotes = occurrences[k];\r\n              break;\r\n          }\r\n      }\r\n  }\r\n  var compId = document.anarkCoreData.getEntityById\(occurrenceToExtractNotes.cadEntityId\).componentId;\r\n  var comp = document.anarkCoreData.getEntityById\(compId\);\r\n  var componentAttributes = document.anarkCoreData.getAttributesInOriginalOrder\(document.anarkCoreData.getEntityById\(compId\)\);\r\n  return comp;\r\n}\r\n\r\n//Populating all the attributes which were previously fetched from MScript to avoid warnings.\r\nfunction populateAttributeValues\(document\) {\r\n\r\n  var comp = getCompIDBasedOnInput\(document\);\r\n\r\n\tvar designedBy = comp.Attributes['DESIGNED_BY'];\r\n\t//console.println\("Designed By value = " + designedBy\);\r\n\tdocument.getField\("Designed By"\).value = \(designedBy ? designedBy : " "\);\r\n\r\n  var drawnBy = comp.Attributes['DRAWN_BY'];\r\n\t//console.println\("Drawn By value = " + drawnBy\);\r\n\tdocument.getField\("Drawn By"\).value = \(drawnBy ? drawnBy : " "\);\r\n\r\n  var revisedBy = comp.Attributes['REVISED_BY'];\r\n\t//console.println\("Revised By value = " + revisedBy\);\r\n\tdocument.getField\("Revised By"\).value = \(revisedBy ? revisedBy : " "\);\r\n\r\n  var mfgEngineer = comp.Attributes['MFG ENGR'];\r\n\t//console.println\("mfgEngineer value = " + mfgEngineer\);\r\n\tdocument.getField\("mfgEngineer"\).value = \(mfgEngineer ? mfgEngineer : " "\);\r\n\r\n  var checkedBy = comp.Attributes['CHECKED_BY'];\r\n\t//console.println\("Checked By value = " + checkedBy\);\r\n\tdocument.getField\("Checked By"\).value = \(checkedBy ? checkedBy : " "\);\r\n\r\n  var finish = comp.Attributes['FINISH'];\r\n\t//console.println\("Finish value = " + finish\);\r\n\tdocument.getField\("Finish"\).value = \(finish ? finish : " "\);\r\n\r\n  var zDescLine1 = comp.Attributes['Z DESC LINE 1'];\r\n\t//console.println\("Line 1 value = " + zDescLine1\);\r\n\tdocument.getField\("Line 1"\).value = \(zDescLine1 ? zDescLine1 : " "\);\r\n\r\n  var zDescLine2 = comp.Attributes['Z DESC LINE 2'];\r\n\t//console.println\("Line 2 value = " + zDescLine2\);\r\n\tdocument.getField\("Line 2"\).value = \(zDescLine2 ? zDescLine2 : " "\);\r\n\r\n  var zDescLine3 = comp.Attributes['Z DESC LINE 3'];\r\n\t//console.println\("Line 3 value = " + zDescLine3\);\r\n\tdocument.getField\("Line 3"\).value = \(zDescLine3 ? zDescLine3 : " "\);\r\n\r\n  var partNumber = comp.Attributes['AMAT PART-NUMBER'];\r\n\t//console.println\("Part Number value = " + partNumber\);\r\n\tdocument.getField\("Part Number"\).value = \(partNumber ? partNumber : " "\);\r\n\r\n  var dbPartRev = comp.Attributes['DB_PART_REV'];\r\n\t//console.println\("DB PartRev value = " + dbPartRev\);\r\n\tdocument.getField\("DB PartRev"\).value = \(dbPartRev ? dbPartRev : " "\);\r\n\r\n  var weight = comp.Attributes['WEIGHT'];\r\n\t//console.println\("Weight value = " + weight\);\r\n\tdocument.getField\("Weight"\).value = \(weight ? weight : " "\);\r\n  \r\n  var dbPartNo = comp.Attributes['DB_PART_NO'];\r\n\t//console.println\("DB Part No value = " + dbPartNo\);\r\n\tdocument.getField\("DB Part No"\).value = \(dbPartNo ? dbPartNo : " "\);\r\n  \r\n  var ecoNum = comp.Attributes['ECO_NUM'];\r\n\t//console.println\("Eco Num value = " + ecoNum\);\r\n\tdocument.getField\("Eco Num"\).value = \(ecoNum ? ecoNum : " "\);\r\n  \r\n  var relStatus = comp.Attributes['REL_STATUS'];\r\n\t//console.println\("Rel Status value = " + relStatus\);\r\n\tdocument.getField\("Rel Status"\).value = \(relStatus ? relStatus : " "\);\r\n\r\n  var weight = comp.Attributes['WEIGHT'];\r\n\t//console.println\("Weight value = " + weight\);\r\n\tdocument.getField\("Weight"\).value = \(weight ? weight : " "\);\r\n\r\n  // {{{ topComponent["OriginalUnits"] && topComponent["OriginalUnits"] === "MILLIMETERS" ? "KG REF" : "LB REF" }}}\r\n  var originalUnits = comp.Attributes['OriginalUnits'];\r\n\t//console.println\("OriginalUnits value = " + originalUnits\);\r\n\tdocument.getField\("Weight 2"\).value = \(originalUnits === "MILLIMETERS" ? "KG REF" : "LB REF"\);\r\n\r\n  //  {{{ \(topComponent["Z MATERIAL LINE 1"] || ''\) + '\\n\\n' + \(topComponent["Z MATERIAL LINE 2"] || ''\) }}}\r\n  var materialValue = comp.Attributes['Z MATERIAL LINE 1'] + '\\n\\n' + comp.Attributes['Z MATERIAL LINE 2'];\r\n\t//console.println\("Material value = " + materialValue\);\r\n\tdocument.getField\("Material Value"\).value = \(materialValue ? materialValue : " "\);\r\n}\r\n\r\n\r\nfunction formattedDate\(document, txtBoxName, AttrName\) {\r\n  var root, acd;\r\n\r\n  acd = document.anarkCoreData;\r\n  root = acd.getRootOccurrence\(\);\r\n  var comp = acd.getEntityById\(root.componentId\);\r\n  var desDate = document.getField\(txtBoxName\);\r\n\r\n  // use RegEx to find attributes that start with attribute name, workaround for attribute suffixing issue\r\n  // {"name":"AMAT PART-NUMBER","objectValue":"0051-37787"}\r\n  var dateAttribute = comp.getAttributesInOriginalOrder\(\).filter\(function \(attribute\) {\r\n    return new RegExp\('^' + AttrName\).test\(attribute.name\);\r\n  }\)[0];\r\n\r\n  if \(dateAttribute !== undefined && dateAttribute !== null\) {\r\n    var dateStr = dateAttribute.objectValue;\r\n    var dateSplits = dateStr.split\(' '\)[0].split\('/'\);\r\n\r\n    if \(dateSplits.length === 1 || dateStr === undefined || desDate === null\) {\r\n      desDate.value = ' ';\r\n    } else {\r\n      var dateObj = new Date\(dateSplits[2], dateSplits[0] - 1, dateSplits[1]\);\r\n      //console.println\("DATE " + dateObj\);\r\n\r\n      var months = [\r\n        'Jan',\r\n        'Feb',\r\n        'Mar',\r\n        'Apr',\r\n        'May',\r\n        'Jun',\r\n        'Jul',\r\n        'Aug',\r\n        'Sep',\r\n        'Oct',\r\n        'Nov',\r\n        'Dec',\r\n      ];\r\n      var formatted_date =\r\n        dateObj.getDate\(\) + '-' + months[dateObj.getMonth\(\)] + '-' + dateObj.getFullYear\(\);\r\n\r\n      desDate.value = formatted_date;\r\n    }\r\n  } else {\r\n    desDate.value = ' ';\r\n  }\r\n}\r\n\r\nfunction populateDateFields\(document\) {\r\n  formattedDate\(document, 'DesignDate', 'DESIGN_DATE'\); //DESIGN_DATE\tDesignDate\r\n  formattedDate\(document, 'DrawnDate', 'DRAWN_DATE'\); //DRAWN_DATE\tDrawnDate\r\n  formattedDate\(document, 'RevisedDate', 'REVISED_DATE'\); //REVISED_DATE\tRevisedDate\r\n  formattedDate\(document, 'MfgEngrDate', 'MFG ENGR DATE'\); //MFG ENGR DATE\tMfgEngrDate\r\n  formattedDate\(document, 'CheckedDate', 'CHECKED_DATE'\); //CHECKED_DATE\tCheckedDate\r\n}\r\nfunction popUpNotes\(document\) {\r\n  var popdoc = openForm\('NotesForm.pdf'\);\r\n  if \(!popdoc\) {\r\n    return;\r\n  }\r\n  popdoc.bringToFront\(\);\r\n  popdoc.xfa.form.form1.Script.populateForm\(document\);\r\n}\r\n\r\nfunction popUpBOM\(document\) {\r\n  var popdoc = openForm\('BOMForm.pdf'\);\r\n  if \(!popdoc\) {\r\n    return;\r\n  }\r\n  popdoc.bringToFront\(\);\r\n  popdoc.xfa.form.form1.Script.populateForm\(document\);\r\n}\r\n\r\n// STANDARD_TEMPLATE_BEGIN\r\n\r\n// Anark Core Version\r\nfunction populateAnarkCoreTemplateVersion\(document\) {\r\n  var field = document.getField\('AnarkCoreTemplateVersion'\);\r\n  if \(field\) {\r\n    field.value = 'v4.4.0';\r\n  }\r\n}\r\n\r\n// Utilities\r\n\r\nfunction getA3d\(document\) {\r\n  var page, a3d;\r\n  for \(page = 0; page < document.numPages; page += 1\) {\r\n    if \(document.getAnnots3D\(page\)\) {\r\n      a3d = document.getAnnots3D\(page\)[0];\r\n      if \(a3d && a3d.context3D && !a3d.activated\) {\r\n        a3d.activated = true;\r\n      }\r\n      if \(a3d && a3d.context3D\) {\r\n        return a3d;\r\n      }\r\n    }\r\n  }\r\n  return null;\r\n}\r\n\r\nfunction getScene\(document\) {\r\n  var a3d = getA3d\(document\);\r\n  if \(a3d && a3d.context3D && a3d.context3D.scene\) {\r\n    return a3d.context3D.scene;\r\n  }\r\n  return null;\r\n}\r\n\r\nfunction getRuntime\(document\) {\r\n  var a3d = getA3d\(document\);\r\n  if \(a3d && a3d.context3D && a3d.context3D.runtime\) {\r\n    return a3d.context3D.runtime;\r\n  }\r\n  return null;\r\n}\r\n\r\nfunction getAkAnimation\(document\) {\r\n  var a3d = getA3d\(document\);\r\n  if \(a3d && a3d.context3D && a3d.context3D.theAnimation\) {\r\n    return a3d.context3D.theAnimation;\r\n  }\r\n  return null;\r\n}\r\n\r\nfunction getA3dPage\(document\) {\r\n  for \(var page = 0; page < document.numPages; page += 1\) {\r\n    var annots = document.getAnnots3D\(page\);\r\n    if \(annots !== undefined && annots !== null && annots.length\) {\r\n      return page;\r\n    }\r\n  }\r\n  return undefined;\r\n}\r\n\r\nfunction stringStartsWith\(bigStr, str\) {\r\n  return bigStr.slice\(0, str.length\) == str;\r\n}\r\n\r\nfunction stringContains\(bigStr, str\) {\r\n  return bigStr.indexOf\(str\) != -1;\r\n}\r\n\r\nfunction openForm\(fName\) {\r\n  try {\r\n    this.exportDataObject\({ cName: fName, nLaunch: 2 }\);\r\n    return this.openDataObject\(fName\);\r\n  } catch \(e\) {\r\n    app.alert\("Can't open form " + fName, 0, 0, 'Not Found'\);\r\n  }\r\n}\r\n\r\nfunction getCadEntityIdFromMetadataString\(metadataString\) {\r\n  var searchStr = 'cadEntityId" value="';\r\n  var startIndex = metadataString.indexOf\(searchStr\);\r\n  if \(startIndex === -1\) return undefined;\r\n  startIndex += searchStr.length;\r\n  var endIndex = metadataString.indexOf\('"', startIndex\);\r\n  return parseInt\(metadataString.slice\(startIndex, endIndex\)\);\r\n}\r\n// Printer\r\n\r\nfunction initializePrinting\(document\) {\r\n  document.getField\('PrinterName'\).setItems\(app.printerNames\);\r\n  document\r\n    .getField\('PrinterName'\)\r\n    .setAction\(\r\n      'Keystroke',\r\n      'if \( event.change && event.change.length \) this.getPrintParams\(\).printerName = event.change;'\r\n    \);\r\n  var pp = document.getPrintParams\(\);\r\n  document.getField\('PrinterName'\).value = pp.printerName;\r\n  pp.interactive = pp.constants.interactionLevel.automatic;\r\n  pp.printContent = pp.constants.printContents.docAndComments;\r\n  pp.firstPage = 0;\r\n  pp.lastPage = 0;\r\n  pp.pageHandling = pp.constants.handling.fit;\r\n  pp.flags &= ~pp.constants.flagValues.suppressRotate;\r\n}\r\n\r\nfunction promptPrintSettings\(document\) {\r\n  document.getField\('PrinterName'\).display = display.visible;\r\n  document.getField\('PrintSettings'\).display = display.visible;\r\n  document.getField\('GoPrint'\).display = display.visible;\r\n  document.getField\('CancelPrint'\).display = display.visible;\r\n  document.getField\('PrinterLabel'\).display = display.visible;\r\n}\r\n\r\nfunction closePrintSettings\(document, doPrint\) {\r\n  document.getField\('PrinterName'\).display = display.hidden;\r\n  document.getField\('PrintSettings'\).display = display.hidden;\r\n  document.getField\('GoPrint'\).display = display.hidden;\r\n  document.getField\('CancelPrint'\).display = display.hidden;\r\n  document.getField\('PrinterLabel'\).display = display.hidden;\r\n\r\n  if \(doPrint\) printSelectedViews\(document\);\r\n}\r\n\r\nfunction printSelectedViews\(document\) {\r\n  var i;\r\n  var pp = document.getPrintParams\(\);\r\n  pp.printerName = document.getField\('PrinterName'\).value;\r\n  pp.interactive = pp.constants.interactionLevel.silent; // uses default settings\r\n  pp.printContent = pp.constants.printContents.docAndComments;\r\n  pp.firstPage = 0;\r\n  pp.lastPage = 0;\r\n  var views = document.anarkCoreData.getViews\(\);\r\n  var scene = getScene\(document\);\r\n  if \(!scene\) {\r\n    return;\r\n  }\r\n  var saveRenderMode = scene.renderMode;\r\n\r\n  for \(i = 0; i < views.length; i++\) {\r\n    if \(document.printArray[i] === 1\) {\r\n      if \(document.viewOffset + document.viewButtonArray.length < views.length\)\r\n        document.viewOffset = i;\r\n      selectViewById\(document, views[i].cadEntityId, false\); // F=no animate\r\n      if \(scene.renderMode !== 'illustration'\) {\r\n        scene.renderMode = 'illustration';\r\n      }\r\n      document.print\(pp\);\r\n    }\r\n  }\r\n\r\n  scene.renderMode = saveRenderMode;\r\n}\r\n\r\n// Populate document fields\r\n\r\nfunction populateFieldIfAttributeMatchesName\(document, textEditField, attributes\) {\r\n  var fieldName, matchFound, i, attrib, sanitizedKeyName, wildCardPrefix, textStr;\r\n\r\n  // Name matching scheme for textEdit fields \(a name may contain only letters, digits, underscores, periods and hyphens\)\r\n  if \(!document.sanitizeKeyName\) {\r\n    document.sanitizeKeyName = function \(keyName\) {\r\n      return keyName.replace\(new RegExp\('[^a-zA-Z0-9._-]', 'g'\), ''\);\r\n    };\r\n  }\r\n  fieldName = textEditField.name;\r\n  // trim and ignore fields that start with bom_\r\n  if \(stringStartsWith\(fieldName, 'bom_'\)\) fieldName = textEditField.name.substring\(4\);\r\n  matchFound = false;\r\n  for \(i = 0; i < attributes.length; i++\) {\r\n    attrib = attributes[i];\r\n    sanitizedKeyName = document.sanitizeKeyName\(attrib.name\); // Remove any non-alphanumeric characters from the attrib key\r\n    if \(/__$/.test\(fieldName\)\) {\r\n      // ends with '__'?\r\n      // a textEditField name that end with '__' will act like a wildcard and it may be populated with multiple matching attributes keys\r\n      // E.g. a field named 'Note__' will be populated with attributes with the key named: 'Note1', 'Note2', and 'Notes'.\r\n      wildCardPrefix = fieldName.substring\(0, fieldName.length - 2\); // remove '__'\r\n      if \(sanitizedKeyName.indexOf\(wildCardPrefix\) === 0\) {\r\n        // key matches the wildcard name\r\n        if \(!matchFound\) {\r\n          textEditField.value = ''; // on first match we clear\r\n        }\r\n\r\n        // append attribute value to textEditField\r\n        textStr = attrib.objectValue.toString\(\).replace\(new RegExp\('\\\\n', 'g'\), ''\); // remove any line breaks\r\n        if \(textEditField.value === ''\) {\r\n          textEditField.value = textStr;\r\n        } else {\r\n          textEditField.value += '\\n\\n' + textStr;\r\n        }\r\n        matchFound = true;\r\n      }\r\n    } else {\r\n      // not a wildcard so only match to a single attribute\r\n      if \(fieldName === sanitizedKeyName\) {\r\n        // key matches the field name so set textEditField to attribute value\r\n        textEditField.value = attrib.objectValue;\r\n        return true; // found match\r\n      } else {\r\n        var copiedOverflowFieldMatch = /\(.*\)\\\(\\d\\\)$/.exec\(textEditField.name\);\r\n        if \(copiedOverflowFieldMatch !== null && sanitizedKeyName === copiedOverflowFieldMatch[1]\) {\r\n          // key matches attribute name without the suffix "\(number\)", e.g.:  fieldname\(2\)\r\n          textEditField.value = attrib.objectValue;\r\n          return true; // found match\r\n        }\r\n      }\r\n    }\r\n  }\r\n  return matchFound;\r\n}\r\n\r\nfunction bindPageFieldToAttributeByMatchingName\(document, textEditField, attributesArray\) {\r\n  var found, i;\r\n\r\n  // ordered search for an attribute with a matching name\r\n  found = false;\r\n  for \(i = 0; i < attributesArray.length && !found; i++\) {\r\n    try {\r\n      found = populateFieldIfAttributeMatchesName\(document, textEditField, attributesArray[i]\);\r\n    } catch \(e\) {}\r\n  }\r\n  if \(!found && document.akPlayer && document.akPlayer.table\) {\r\n    // next search the field names of the current work step\r\n    var table = document.akPlayer.table;\r\n    for \(i = 0, k = table.rawTableValue.columns.length; i < k && !found; i += 1\) {\r\n      var colName = table.rawTableValue.columns[i].name;\r\n      var sanitizedKeyName = document.sanitizeKeyName\(colName\); // Remove any non-alphanumeric characters from the attrib key\r\n      if \(textEditField.name === sanitizedKeyName\) {\r\n        textEditField.value = table.getCellValueByName\(\r\n          document.akPlayer.stepsListBox.currentValueIndices,\r\n          colName\r\n        \);\r\n        found = true;\r\n      }\r\n    }\r\n  }\r\n  if \(found\) {\r\n    try {\r\n      textEditField.readonly = true;\r\n    } catch \(e\) {}\r\n  }\r\n  return found;\r\n}\r\n\r\nfunction isReservedField\(field\) {\r\n  if \(stringStartsWith\(field.name, 'bom_'\)\) return true;\r\n  return field.defaultValue !== '';\r\n}\r\n\r\nfunction getTopLevelAnnotationIds\(document\) {\r\n  var gdts = [];\r\n  var occurrences = document.anarkCoreData.getOccurrences\(\);\r\n  for \(var i = 0; i < occurrences.length; i += 1\) {\r\n    var occ = occurrences[i];\r\n    if \(occ.typeOfEntity === 'GdtOccurrence' && occ.Attributes['Product Structure Depth'] === 2\) {\r\n      gdts.push\(occ.referencedId\);\r\n    }\r\n  }\r\n  return gdts;\r\n}\r\n\r\nfunction getNotesAsAttributes\(document\) {\r\n  var attributesArray = [];\r\n  var annotIds = getTopLevelAnnotationIds\(document\);\r\n  for \(var i = 0; i < annotIds.length; i++\) {\r\n    var gdt = document.anarkCoreData.getEntityById\(annotIds[i]\);\r\n    if \(gdt.Attributes['Type'] === 'Note'\) {\r\n      var text = gdt.Attributes['noteText']; // CREO\r\n      if \(!text\) text = gdt.Attributes['text']; // NX\r\n      if \(text && gdt.Attributes['text']\) text.replace\(/<\(.*\)>/g, ''\);\r\n      if \(!text\) text = gdt.Attributes['Text']; // SW\r\n      if \(!text\) text = gdt.Attributes['TextStrings']; // CATIA\r\n      if \(!text\) text = 'No PMI notes found.';\r\n      var fakeAttrib = { name: gdt.name, objectValue: text };\r\n      attributesArray.push\(fakeAttrib\);\r\n    }\r\n  }\r\n  return attributesArray;\r\n}\r\n\r\nfunction populateDocFields\(document\) {\r\n  var root, acd, attributesArray;\r\n\r\n  // ordered array of attributes used for populating fields\r\n  attributesArray = [];\r\n  acd = document.anarkCoreData;\r\n  root = acd.getRootOccurrence\(\);\r\n  if \(root.instanceId\) {\r\n    attributesArray.push\(acd.getAttributesInSmartSortedOrder\(acd.getEntityById\(root.instanceId\)\)\);\r\n  }\r\n  attributesArray.push\(acd.getAttributesInSmartSortedOrder\(acd.getEntityById\(root.componentId\)\)\);\r\n  attributesArray.push\(acd.getAttributesInSmartSortedOrder\(acd.product.Workspace\)\);\r\n  attributesArray.push\(getNotesAsAttributes\(document\)\);\r\n\r\n  for \(var i = 0; i < document.numFields; i++\) {\r\n    var fname = document.getNthFieldName\(i\);\r\n    var field = document.getField\(fname\);\r\n    if \(!isReservedField\(field\) && field.type === 'text'\) {\r\n      bindPageFieldToAttributeByMatchingName\(document, field, attributesArray\);\r\n    }\r\n  }\r\n}\r\n// View carousel\r\n\r\nfunction akSetPrintFlags\(document\) {\r\n  var views = document.anarkCoreData.getViews\(\);\r\n  for \(var i = 0; i < document.checkBoxArray.length; i += 1\) {\r\n    var checkbox = document.checkBoxArray[i];\r\n    document.printArray[i + document.viewOffset] = checkbox.isBoxChecked\(0\);\r\n    checkbox.display = i + document.viewOffset < views.length ? display.visible : display.hidden;\r\n  }\r\n}\r\n\r\nfunction toggleSelect\(document, isChecked\) {\r\n  var views = document.anarkCoreData.getViews\(\);\r\n  for \(var i = 0; i < views.length; i += 1\) {\r\n    document.printArray[i] = isChecked ? 1 : 0;\r\n  }\r\n  for \(var i = 0; i < document.checkBoxArray.length; i += 1\) {\r\n    if \(i + document.viewOffset < views.length\)\r\n      document.checkBoxArray[i].checkThisBox\(0, isChecked\);\r\n  }\r\n}\r\n\r\nfunction initializeViewCarousel\(document\) {\r\n  var i, fname, field, viewId, view;\r\n\r\n  saveIconsInCaseOfReaderEnable\(document\);\r\n  document.lastPreviewIndex = -1;\r\n\r\n  // add the icons to the views so that we don't have to worry about sort order\r\n  if \(document.icons\) {\r\n    for \(i = 0; i < document.icons.length; i += 1\) {\r\n      viewId = parseInt\(document.icons[i].name.substring\(0, 8\), 10\);\r\n      if \(isNaN\(viewId\)\) {\r\n        // Our thumbnail icons have the viewId encoded in the first 8 chars so not one of our icons, maybe a user markup icon\r\n      } else {\r\n        view = document.anarkCoreData.getEntityById\(viewId\);\r\n        if \(view\) view.icon = document.icons[i];\r\n      }\r\n    }\r\n  }\r\n\r\n  document.checkBoxArray = [];\r\n  document.viewButtonArray = [];\r\n  for \(i = 0; i < this.numFields; i++\) {\r\n    fname = this.getNthFieldName\(i\);\r\n    field = this.getField\(fname\);\r\n    if \(\(/^ImageButton/.test\(fname\) || /^ViewButton/.test\(fname\)\) && field.type === 'button'\) {\r\n      document.viewButtonArray.push\(field\);\r\n    }\r\n    if \(/^ViewPrintSelect/.test\(fname\) && field.type === 'checkbox'\) {\r\n      document.checkBoxArray.push\(field\);\r\n    }\r\n  }\r\n\r\n  var views = document.anarkCoreData.getViews\(\);\r\n  document.printArray = [];\r\n  for \(i = 0; i < views.length; i++\) {\r\n    document.printArray.push\(0\);\r\n  }\r\n\r\n  document.viewOffset = 0;\r\n  document.selectedViewIndex = -1;\r\n  akSetPrintFlags\(document\);\r\n  updateViewImages\(document\);\r\n\r\n  document.dirty = false;\r\n}\r\n\r\nfunction saveIconsInCaseOfReaderEnable\(document\) {\r\n  var i, field;\r\n  try {\r\n    if \(document.icons\) {\r\n      for \(i = 0; i < document.icons.length; i++\) {\r\n        field = this.addField\('icon' + i, 'button', 0, [0, 0, 5, 5]\);\r\n        field.buttonPosition = 2;\r\n        field.buttonSetIcon\(document.icons[i]\);\r\n      }\r\n    }\r\n  } catch \(e\) {\r\n    // Reader 10.1.8 throws a NotAllowedError exception\r\n  }\r\n}\r\n\r\nfunction stripr9CharPrefix\(encodedName\) {\r\n  return encodedName.substr\(9\);\r\n}\r\n\r\nfunction updateViewImages\(document\) {\r\n  var views, view, button, i;\r\n  try {\r\n    views = document.anarkCoreData.getViews\(\);\r\n\r\n    for \(\r\n      i = 0;\r\n      i < document.viewButtonArray.length && i + document.viewOffset < views.length;\r\n      i += 1\r\n    \) {\r\n      view = views[i + document.viewOffset];\r\n      button = document.viewButtonArray[i];\r\n\r\n      button.buttonSetIcon\(view.icon\);\r\n      button.buttonSetCaption\(view.name\);\r\n\r\n      button.fillColor =\r\n        view.cadEntityId === document.selectedViewId ? ['RGB', 0.784, 0.863, 0.941] : color.white;\r\n\r\n      if \(document.checkBoxArray[i]\)\r\n        document.checkBoxArray[i].checkThisBox\(0, document.printArray[i + document.viewOffset]\);\r\n    }\r\n    document.getField\('goToPreviousView'\).textColor =\r\n      document.viewOffset <= 0 ? color.gray : color.black;\r\n    document.getField\('goToNextView'\).textColor =\r\n      document.viewOffset >= views.length - document.viewButtonArray.length\r\n        ? color.gray\r\n        : color.black;\r\n  } catch \(e\) {\r\n    // 10.1.8 throws a NotAllowedError exception if buttonSetIcon is called from a Open notification event\r\n  }\r\n}\r\n\r\nfunction setSceneRenderStyle\(document\) {\r\n  var scene = getScene\(document\);\r\n  if \(!scene\) {\r\n    return;\r\n  }\r\n  // preserve "solid outline" rendering style\r\n  if \(scene.renderMode !== 'solid outline'\) {\r\n    scene.renderMode = 'solid outline';\r\n  }\r\n  // set section caps to "solid" rendering style\r\n  setCapsToSolidRenderMode\(document\);\r\n}\r\n\r\nfunction selectViewById\(document, viewId, smooth\) {\r\n  var selectedView;\r\n  var preview = document.getField\('Preview'\);\r\n  var views = document.anarkCoreData.getViews\(\);\r\n  for \(var i = 0; i < views.length; i++\) {\r\n    if \(views[i].cadEntityId === viewId\) {\r\n      selectedView = views[i];\r\n      document.selectedViewId = views[i].cadEntityId;\r\n      break;\r\n    }\r\n  }\r\n  if \(selectedView\) {\r\n    updateViewImages\(document\);\r\n    if \(preview\) {\r\n      try {\r\n        preview.buttonSetIcon\(selectedView.icon\);\r\n      } catch \(e\) {}\r\n    }\r\n    document.lastPreviewIndex = i;\r\n    var runTime = getRuntime\(document\);\r\n    if \(!runTime\) {\r\n      return;\r\n    }\r\n\r\n    // Disable view rotate for views with title blocks--any view that contains *title* will be set to pan only.\r\n    if \(stringContains\(selectedView.originalName.toLowerCase\(\), 'title'\)\) {\r\n      runTime.overrideSpinTool = 1;\r\n      runTime.setCurrentTool\('Pan'\);\r\n    } else {\r\n      runTime.overrideNavTools = 0;\r\n      runTime.setCurrentTool\('Rotate'\);\r\n    }\r\n\r\n    // We use the "name" here rather than originalName because it will match the unique 3D view names.\r\n    // "originalName" is the not-necessarily-unique and non-mangled name.\r\n    runTime.setView\(selectedView.name, smooth\);\r\n  }\r\n  setSceneRenderStyle\(document\);\r\n}\r\n\r\nfunction showPreview\(document, buttonIndex\) {\r\n  var views = document.anarkCoreData.getViews\(\);\r\n  var viewIndex = document.viewOffset + buttonIndex;\r\n  if \(viewIndex >= views.length\) {\r\n    return;\r\n  }\r\n  var preview = document.getField\('Preview'\);\r\n  preview.buttonSetIcon\(views[viewIndex].icon\);\r\n}\r\n\r\nfunction unshowPreview\(document\) {\r\n  var views = document.anarkCoreData.getViews\(\);\r\n  var preview = document.getField\('Preview'\);\r\n  if \(document.lastPreviewIndex !== -1\)\r\n    preview.buttonSetIcon\(views[document.lastPreviewIndex].icon\);\r\n}\r\n\r\nfunction selectLastPreview\(document\) {\r\n  var views = document.anarkCoreData.getViews\(\);\r\n  if \(document.lastPreviewIndex !== -1\)\r\n    selectViewById\(document, views[document.lastPreviewIndex].cadEntityId, true\);\r\n}\r\n\r\nfunction selectView\(document, buttonIndex\) {\r\n  var viewIndex, views;\r\n\r\n  viewIndex = document.viewOffset + buttonIndex;\r\n  views = document.anarkCoreData.getViews\(\);\r\n  if \(viewIndex >= views.length\) {\r\n    return;\r\n  }\r\n  selectViewById\(document, views[viewIndex].cadEntityId, true\);\r\n}\r\n\r\nfunction setViewPrevious\(document\) {\r\n  if \(document.viewOffset > 0\) {\r\n    document.viewOffset = document.viewOffset - 1;\r\n    updateViewImages\(document\);\r\n  }\r\n}\r\n\r\nfunction setViewNext\(document\) {\r\n  if \(\r\n    document.viewOffset + document.viewButtonArray.length <\r\n    document.anarkCoreData.getViews\(\).length\r\n  \) {\r\n    document.viewOffset = document.viewOffset + 1;\r\n    updateViewImages\(document\);\r\n  }\r\n}\r\n\r\nfunction setViewPreviousFive\(document\) {\r\n  for \(var i = 0; i < 5; i++\) setViewPrevious\(document\);\r\n}\r\nfunction setViewNextFive\(document\) {\r\n  for \(var i = 0; i < 5; i++\) setViewNext\(document\);\r\n}\r\n\r\nfunction setInitialView\(document\) {\r\n  if \(document.isViewInitialized\) return;\r\n  document.isViewInitialized = true;\r\n  setDefaultView\(document\);\r\n  document.dirty = false;\r\n}\r\n\r\nfunction setDefaultView\(document\) {\r\n  var views = document.anarkCoreData.getViews\(\);\r\n  var smooth = true;\r\n  for \(var i = 0; i < views.length; i++\) {\r\n    if \(views[i].isDefault\) {\r\n      selectViewById\(document, views[i].cadEntityId, smooth\);\r\n      return;\r\n    }\r\n  }\r\n  if \(document.icons && document.icons.length > 0\) {\r\n    var viewId = parseInt\(document.icons[0].name.substring\(0, 8\), 10\);\r\n    selectViewById\(document, viewId, smooth\);\r\n  }\r\n}\r\n\r\nfunction smoothViewPlaneSize\(document, endSize\) {\r\n  // animate with a timer\r\n  var runtime = getRuntime\(document\);\r\n  var scene = getScene\(document\);\r\n  if \(!scene || !runtime\) return;\r\n  var a3d = getA3d\(document\);\r\n  var c3d = a3d.context3D;\r\n  var camera = scene.cameras.getByIndex\(0\);\r\n  var startSize = camera.viewPlaneSize;\r\n  var myTimer = new c3d.TimeEventHandler\(\);\r\n  var count = 0;\r\n  var numSteps = 30;\r\n  myTimer.onEvent = function \(event\) {\r\n    var t = count / numSteps;\r\n    camera.viewPlaneSize = \(1 - t\) * startSize + t * endSize;\r\n    count++;\r\n    if \(count >= numSteps\) {\r\n      camera.viewPlaneSize = endSize;\r\n      runtime.removeEventHandler\(myTimer\);\r\n    }\r\n  };\r\n  runtime.addEventHandler\(myTimer\);\r\n}\r\n\r\n////////////////////////////////////////////////////////////////\r\n// Start cross-section cap support functions\r\n////////////////////////////////////////////////////////////////\r\n\r\nfunction createCapLookups\(document\) {\r\n  var createdAllLookups, scene, i, node, cadEntityId, thermometer;\r\n\r\n  if \(document.createdSelectionLookups === true\) {\r\n    return;\r\n  }\r\n\r\n  scene = getScene\(document\);\r\n  if \(!scene\) {\r\n    return;\r\n  }\r\n\r\n  document.entityIdToNodeMap = {};\r\n  createdAllLookups = true;\r\n\r\n  thermometer = app.thermometer; // acquire a thermometer object\r\n  thermometer.duration = scene.nodes.count;\r\n  thermometer.begin\(\);\r\n\r\n  for \(i = 0; i < scene.nodes.count; i += 1\) {\r\n    thermometer.value = i;\r\n    thermometer.text = 'Initializing ' + \(i + 1\);\r\n    if \(thermometer.cancelled\) {\r\n      createdAllLookups = false;\r\n      break;\r\n    }\r\n\r\n    node = scene.nodes.getByIndex\(i\);\r\n\r\n    if \(node.metadataString\) {\r\n      cadEntityId = getCadEntityIdFromMetadataString\(node.metadataString\);\r\n      if \(cadEntityId\) {\r\n        node.cadEntityId = cadEntityId;\r\n        document.entityIdToNodeMap[cadEntityId] = node;\r\n      }\r\n    }\r\n  }\r\n\r\n  thermometer.end\(\);\r\n  document.createdSelectionLookups = createdAllLookups;\r\n}\r\n\r\nfunction highlightCap\(mesh\) {\r\n  mesh.renderMode = 'solid';\r\n  mesh.opacity = 1.0;\r\n}\r\n\r\nfunction highlightCapSubtree\(document, node\) {\r\n  while \(node !== null\) {\r\n    highlightCap\(node\);\r\n    if \(node !== null\) {\r\n      highlightCapSubtree\(document, node.firstChild\);\r\n    }\r\n    node = node.nextSibling;\r\n  }\r\n}\r\n\r\nfunction highlightCapOccurrence\(document, occurrenceId\) {\r\n  var node;\r\n\r\n  createCapLookups\(document\);\r\n\r\n  node = document.entityIdToNodeMap[occurrenceId.toString\(\)];\r\n  highlightCap\(node\);\r\n  highlightCapSubtree\(document, node.firstChild\);\r\n}\r\n\r\nfunction setCapsToSolidRenderMode\(document\) {\r\n  var supplementals, i;\r\n\r\n  supplementals = document.anarkCoreData.getSupplementals\(\);\r\n\r\n  for \(i = 0; i < supplementals.length; i += 1\) {\r\n    if \(supplementals[i].name.indexOf\('Anark_Cap'\) === 0\) {\r\n      highlightCapOccurrence\(document, supplementals[i].cadEntityId\);\r\n    }\r\n  }\r\n}\r\n\r\n////////////////////////////////////////////////////////////////\r\n// End cross-section cap support functions\r\n////////////////////////////////////////////////////////////////\r\n// BOM code\r\n\r\nfunction AKBom\(bomListBox\) {\r\n  if \(bomListBox === null || bomListBox.currentValueIndices === null\) {\r\n    throw 'Arg1 is not an Acroform ListBox';\r\n  }\r\n  this.bomListBox = bomListBox;\r\n  this.selectedOccurrenceId = null;\r\n  this.selectedNode = undefined;\r\n\r\n  this.doUnselect = function \(\) {\r\n    if \(this.performUnselect\) {\r\n      this.highlightAllOccurrences\(this.document, -1, false\);\r\n      this.selectedOccurrenceId = null;\r\n      this.selectedBomIndex = -1;\r\n      this.populateBOMFields\(this.document\);\r\n    }\r\n  };\r\n\r\n  this.elevateNodeToBom = function \(document, givenNode\) {\r\n    if \(givenNode.metadataString\) {\r\n      var cadEntityId = getCadEntityIdFromMetadataString\(givenNode.metadataString\);\r\n      if \(cadEntityId\) {\r\n        var entity = document.anarkCoreData.getEntityById\(cadEntityId\);\r\n        if \(\r\n          entity &&\r\n          \(entity.typeOfEntity === 'Part' ||\r\n            entity.typeOfEntity === 'PartOccurrence' ||\r\n            entity.typeOfEntity === 'AssemblyOccurrence'\)\r\n        \) {\r\n          // try to elevate to a node that is in the BOM list\r\n          var node = givenNode;\r\n          while \(node\) {\r\n            if \(this.nodeNameToOccurrenceIdMap[node.name]\) {\r\n              var occId = this.nodeNameToOccurrenceIdMap[node.name];\r\n              if \(this.bomOccurrenceIdToIndex[occId] !== undefined\) return node;\r\n            }\r\n            node = node.parent;\r\n          }\r\n        }\r\n      }\r\n    }\r\n    return givenNode;\r\n  };\r\n\r\n  this.selectionEventCallback = function \(document, event\) {\r\n    var occId;\r\n    if \(event.selected\) {\r\n      this.performUnselect = false;\r\n      if \(event.node && this.nodeNameToOccurrenceIdMap\) {\r\n        var node = this.elevateNodeToBom\(document, event.node\);\r\n        occId = this.nodeNameToOccurrenceIdMap[node.name];\r\n        if \(occId\) {\r\n          this.selectedNode = node;\r\n          this.bomHighlight\(document, occId\);\r\n        }\r\n      }\r\n    } else {\r\n      this.performUnselect = true;\r\n      this.document = document;\r\n      app.setTimeOut\('this.akBom.doUnselect\(\)', 50\);\r\n    }\r\n  };\r\n\r\n  this.getBomQuantityAsString = function \(document, index\) {\r\n    if \(this.bomListOccurrenceIds[index].length === 1\) {\r\n      var root = document.anarkCoreData.getRootOccurrence\(\);\r\n      if \(this.bomListOccurrenceIds[index][0] === root.cadEntityId\) return 'X';\r\n    }\r\n    var quantity = this.bomListOccurrenceIds[index].length;\r\n    return quantity.toString\(\);\r\n  };\r\n\r\n  this.buildTopLevelComponents = function \(document\) {\r\n    this.bomListOccurrenceIds = []; // a list of lists, i,e, an index in the BOM list may correspond to multiple occurrence IDs\r\n    this.bomOccurrenceIdToIndex = []; // a map from occId to its index in the above list\r\n\r\n    var occurrences = document.anarkCoreData.getOccurrences\(\);\r\n    var topLeveloccurrenceIds = [];\r\n    for \(var i = 0; i < occurrences.length; i++\) {\r\n      var occ = occurrences[i];\r\n      if \(\r\n        occ.Attributes['Product Structure Depth'] === 2 &&\r\n        \(occ.typeOfEntity === 'PartOccurrence' || occ.typeOfEntity === 'AssemblyOccurrence'\)\r\n      \) {\r\n        topLeveloccurrenceIds.push\(occ.cadEntityId\);\r\n      }\r\n    }\r\n\r\n    if \(topLeveloccurrenceIds.length === 0\) {\r\n      // add piece part\r\n      var root = document.anarkCoreData.getRootOccurrence\(\);\r\n      topLeveloccurrenceIds.push\(root.cadEntityId\);\r\n    }\r\n\r\n    // aggregate occurrences of components that share the same name\r\n    for \(var i = 0; i < topLeveloccurrenceIds.length; i++\) {\r\n      if \(topLeveloccurrenceIds[i] !== -1\) {\r\n        // not consumed\r\n        var occIdI = topLeveloccurrenceIds[i];\r\n        var occIdArray = [];\r\n        occIdArray.push\(occIdI\);\r\n        var compIdI = document.anarkCoreData.getEntityById\(occIdI\).componentId;\r\n        var compI = document.anarkCoreData.getEntityById\(compIdI\);\r\n        for \(var j = i + 1; j < topLeveloccurrenceIds.length; j++\) {\r\n          if \(topLeveloccurrenceIds[j] !== -1\) {\r\n            // not consumed\r\n            var compIdJ = document.anarkCoreData.getEntityById\(topLeveloccurrenceIds[j]\)\r\n              .componentId;\r\n            var compJ = document.anarkCoreData.getEntityById\(compIdJ\);\r\n            if \(compI.name === compJ.name\) {\r\n              // share same component name?\r\n              occIdArray.push\(topLeveloccurrenceIds[j]\);\r\n              topLeveloccurrenceIds[j] = -1; // mark as consumed\r\n            }\r\n          }\r\n        }\r\n        var bomListIndex = this.bomListOccurrenceIds.length;\r\n        this.bomListOccurrenceIds.push\(occIdArray\);\r\n        for \(var k = 0; k < occIdArray.length; k++\)\r\n          this.bomOccurrenceIdToIndex[occIdArray[k]] = bomListIndex;\r\n      }\r\n    }\r\n  };\r\n\r\n  /**\r\n   * added by L. Peterson when updating BOM population\r\n   */\r\n  this.populateBOMListFromPmiTable = function \(document\) {\r\n    var dirty = document.dirty;\r\n    if \(!document.notify3DAnnotPageOpen\) {\r\n      document.notify3DAnnotPageOpen = function \(\) {\r\n        document.akBom.createSelectionLookups\(document\);\r\n        setInitialView\(document\);\r\n      };\r\n    }\r\n\r\n    this.bomListOccurrenceIds = []; // a list of lists, i,e, an index in the BOM list may correspond to multiple occurrence IDs\r\n    this.bomOccurrenceIdToIndex = []; // a map from occId to its index in the above list\r\n\r\n    this.buildPartsListFromPmiTable\(document\);\r\n    document.dirty = dirty;\r\n  };\r\n\r\n  /**\r\n   * added by L. Peterson when updating BOM population\r\n   */\r\n  this.buildPartsListFromPmiTable = function \(document\) {\r\n    var listBoxItems = [];\r\n    var annotIds = getTopLevelAnnotationIds\(document\);\r\n    for \(var i = 0; i < annotIds.length; i++\) {\r\n      var gdt = document.anarkCoreData.getEntityById\(annotIds[i]\);\r\n      if \(gdt.Attributes['pmiType'] === 'PmiNote'\) {\r\n        var text = gdt.Attributes['text']; // NX\r\n        if \(text && gdt.Attributes['text']\) {\r\n          if \(stringContains\(text.toLowerCase\(\), 'part list:'\)\) {\r\n            var bomLines = text.split\('\\n'\);\r\n            var previousTcEngNumber;\r\n            for \(var j = 3; j < bomLines.length; j++\) {\r\n              var bomRowText;\r\n              var pmiRowtext = bomLines[j];\r\n\r\n              // parse out TC Engineering Number, keep wrapped in parentheses for display in BOM List\r\n              var wrappedTcEngNumber = pmiRowtext.match\(/\\s\\\(TC[0-9]-[0-9]{7}\\\)\\s/gm\);\r\n\r\n              // if we have TC Engineering number ensure it is visible\r\n              var tcEngNum;\r\n              var bomListIndex;\r\n              if \(wrappedTcEngNumber != null\) {\r\n                // the return value from .match\(...\) is not a proper string\r\n                wrappedTcEngNumber = wrappedTcEngNumber.toString\(\);\r\n\r\n                // remove wrapping parentheses from TC Eng Number to match CAD attributes\r\n                tcEngNum = wrappedTcEngNumber.replace\('\(', ''\).replace\('\)', ''\).replace\(/\\s/g, ''\);\r\n\r\n                // track the TC Eng Number for overflow description rows\r\n                previousTcEngNumber = tcEngNum;\r\n\r\n                // build bom row text ensuring the TC Eng Number is present\r\n                bomRowText =\r\n                  this.rpad\(pmiRowtext.replace\(wrappedTcEngNumber, ''\), 90\) + wrappedTcEngNumber;\r\n\r\n                // add item to BOM for association, get verified index back\r\n                bomListIndex = this.addTopLevelItemToBom\(\r\n                  document,\r\n                  tcEngNum,\r\n                  listBoxItems.length\r\n                \);\r\n              } else {\r\n                // overflow description row\r\n                console.println\('Description row, using prev tc num : ' + previousTcEngNumber\);\r\n\r\n                // use previous TC Eng Number\r\n                tcEngNum = previousTcEngNumber;\r\n\r\n                // just use returned text, pad it to prevent overflow\r\n                bomRowText = this.rpad\(pmiRowtext, 90\) + ' \(' + tcEngNum + '\) ';\r\n\r\n                // add propper mapping\r\n                bomListIndex = listBoxItems.length;\r\n                this.bomListOccurrenceIds[bomListIndex] = this.bomListOccurrenceIds[bomListIndex - 1];\r\n              }\r\n\r\n              // create item pair for BOM selection, use index recieved from adding top level BOM item\r\n              var itemPair = [];\r\n              itemPair.push\(bomRowText\);\r\n              itemPair.push\(\r\n                bomListIndex !== null && bomListIndex !== undefined\r\n                  ? bomListIndex.toString\(\)\r\n                  : 'NaN'\r\n              \); //use i so that listbox change event returns index, not id\r\n              listBoxItems.push\(itemPair\);\r\n            }\r\n\r\n            // only process 1 PMI BOM\r\n            break;\r\n          }\r\n        }\r\n      }\r\n    }\r\n\r\n    if \(listBoxItems.length !== 0\) {\r\n      try {\r\n        this.bomListBox.setItems\(listBoxItems\);\r\n      } catch \(e\) {}\r\n      this.clearBomListBoxSelection\(\);\r\n    }\r\n  };\r\n\r\n  /**\r\n   * added by L. Peterson when updating BOM population\r\n   */\r\n  this.addTopLevelItemToBom = function \(document, partNumber, index\) {\r\n    var occurrences = document.anarkCoreData.getOccurrences\(\);\r\n    var occIdArray = [];\r\n    for \(var i = 0; i < occurrences.length; i++\) {\r\n      var occ = occurrences[i];\r\n      if \(\r\n        occ.Attributes['Product Structure Depth'] === 2 && // depth 2 => top level\r\n        \(occ.typeOfEntity === 'PartOccurrence' || occ.typeOfEntity === 'AssemblyOccurrence'\)\r\n      \) {\r\n        var compId = document.anarkCoreData.getEntityById\(occ.cadEntityId\).componentId;\r\n        var comp = document.anarkCoreData.getEntityById\(compId\);\r\n        if \(\r\n          \(comp.Attributes['DB_PART_NO'] &&\r\n            comp.Attributes['DB_PART_NO'].replace\(/\\s/g, ''\).toLowerCase\(\) ===\r\n              partNumber.replace\(/\\s/g, ''\).toLowerCase\(\)\) ||\r\n          \(comp.Attributes['PART_NAME'] &&\r\n            comp.Attributes['PART_NAME'].replace\(/\\s/g, ''\).toLowerCase\(\) ===\r\n              partNumber.replace\(/\\s/g, ''\).toLowerCase\(\)\)\r\n        \) {\r\n          console.println\(\r\n            'Found match for ' +\r\n              partNumber +\r\n              ' with ' +\r\n              comp.Attributes['DB_PART_NO'] +\r\n              ' for bom index ' +\r\n              index +\r\n              '.\\n\\n'\r\n          \);\r\n          occIdArray.push\(occ.cadEntityId\); // we have a match\r\n        }\r\n      }\r\n    }\r\n\r\n    if \(occIdArray.length == 0\) {\r\n      console.println\('Not found: ' + partNumber\);\r\n      return null;\r\n    }\r\n\r\n    this.bomListOccurrenceIds[index] = occIdArray;\r\n    for \(var k = 0; k < occIdArray.length; k++\) {\r\n      this.bomOccurrenceIdToIndex[occIdArray[k]] = index;\r\n    }\r\n\r\n    return index;\r\n  };\r\n\r\n  this.populateBOMList = function \(document\) {\r\n    var sortedListItems = [];\r\n    var BOMLines = [];\r\n    var BOMListItemMap = [];\r\n    var rowText1, rowText2, rowText;\r\n    if \(!document.notify3DAnnotPageOpen\) {\r\n      document.notify3DAnnotPageOpen = function \(\) {\r\n        document.akBom.createSelectionLookups\(document\);\r\n        setInitialView\(document\);\r\n      };\r\n    }\r\n    this.buildTopLevelComponents\(document\);\r\n\r\n    var annotIds = getTopLevelAnnotationIds\(document\);\r\n    for \(var i = 0; i < annotIds.length; i++\) {\r\n      var gdt = document.anarkCoreData.getEntityById\(annotIds[i]\);\r\n      if \(gdt.Attributes['pmiType'] === 'PmiNote'\) {\r\n        var text = gdt.Attributes['text']; // NX\r\n        if \(text && gdt.Attributes['text']\) {\r\n          if \(stringContains\(text.toLowerCase\(\), 'part list:'\)\) {\r\n            //text.replace\(/<\(.*\)>/g, ""\)\r\n            BOMLines = text.split\('\\n'\);\r\n            for \(var j = 3; j < BOMLines.length; j++\) {\r\n              //console.println\("########"+BOMLines[j]\);\r\n              rowText1 = this.rpad\(BOMLines[j], 90\);\r\n              //console.println\("rowText1" + rowText1\);\r\n              //rowText2 = this.lpad\(BOMLines[j], 15\);\r\n              rowText2 = BOMLines[j].match\(/\\s\\\(TC[0-9]-[0-9]{7}\\\)\\s/gm\);\r\n\r\n              //console.println\("rowText2" + rowText2\);\r\n              if \(rowText2 != null\) {\r\n                rowText = rowText1 + rowText2;\r\n              } else {\r\n                //console.println\("&&&&&&&&&"+ rowText\);\r\n                rowText = rowText1;\r\n              }\r\n              //console.println\("rowText"+ rowText\);\r\n\r\n              BOMListItemMap.push\(rowText\);\r\n            }\r\n          }\r\n        }\r\n      }\r\n    }\r\n    for \(i = 0; i < BOMListItemMap.length; i++\) {\r\n      sortedListItems.push\(BOMListItemMap[i]\);\r\n      //console.println\("@@@@"+ BOMListItemMap[i]\);\r\n    }\r\n\r\n    if \(sortedListItems.length > 0\) {\r\n      this.bomListBox.setItems\(sortedListItems\);\r\n    }\r\n\r\n    this.clearBomListBoxSelection\(\);\r\n    document.dirty = dirty;\r\n  };\r\n  this.doesTextCollide = function \(rowText, listBoxItems\) {\r\n    for \(var i = 0; i < listBoxItems.length; i++\) {\r\n      var text = listBoxItems[i][0];\r\n      if \(text === rowText\) {\r\n        return true;\r\n      }\r\n    }\r\n    return false;\r\n  };\r\n\r\n  this.avoidCollisions = function \(rowText, listBoxItems\) {\r\n    var newText = rowText.toString\(\);\r\n    var count = 1;\r\n    while \(this.doesTextCollide\(newText, listBoxItems\)\) {\r\n      count++;\r\n      newText = rowText.toString\(\) + '              \(' + count.toString\(\) + '\)';\r\n    }\r\n    return newText;\r\n  };\r\n\r\n  this.rpad = function \(textString, length\) {\r\n    if \(!textString\) textString = '';\r\n    var str = textString.toString\(\).substring\(0, length\);\r\n    while \(str.length < length\) str = str + ' ';\r\n    return str;\r\n  };\r\n\r\n  this.lpad = function \(textString, length\) {\r\n    if \(!textString\) textString = '';\r\n    var str = textString.toString\(\).substring\(0, length\);\r\n    while \(str.length < length\) str = ' ' + str;\r\n    return str;\r\n  };\r\n\r\n  this.isNodeAChildOf = function \(node, selOccId\) {\r\n    if \(!node\) return false;\r\n    var occId = this.nodeNameToOccurrenceIdMap[node.name];\r\n    if \(occId === selOccId\) {\r\n      return true;\r\n    }\r\n    return this.isNodeAChildOf\(node.parent, selOccId\);\r\n  };\r\n\r\n  this.isDatumNode = function \(node\) {\r\n    if \(!node || !node.name\) {\r\n      return false;\r\n    }\r\n    if \(node.name.substring\(0, 6\) === 'DATUM.'\) return true;\r\n    return this.isDatumNode\(node.parent\);\r\n  };\r\n\r\n  this.getBoundingBox = function \(document, scene\) {\r\n    var bbox, mesh, i;\r\n    if \(this.selectedOccurrenceId\) {\r\n      for \(i = 0; i < scene.meshes.count; i++\) {\r\n        mesh = scene.meshes.getByIndex\(i\);\r\n        mesh.wasVisible = mesh.visible;\r\n      }\r\n      this.isolate\(document\);\r\n      bbox = scene.computeBoundingBox\(\);\r\n      for \(i = 0; i < scene.meshes.count; i++\) {\r\n        mesh = scene.meshes.getByIndex\(i\);\r\n        if \(mesh.visible !== mesh.wasVisible\) {\r\n          mesh.visible = mesh.wasVisible;\r\n        }\r\n      }\r\n      return bbox;\r\n    }\r\n    return scene.computeBoundingBox\(\);\r\n  };\r\n\r\n  this.zoom = function \(document\) {\r\n    var scene;\r\n    scene = getScene\(document\);\r\n    if \(!scene\) {\r\n      return;\r\n    }\r\n    var camera = scene.cameras.getByIndex\(0\);\r\n    var upVec = camera.up.subtract\(camera.position\);\r\n    var box = this.getBoundingBox\(document, scene\);\r\n    var factor = 1.7320508075688772935274463415059; //sqr\(3\)\r\n    var r =\r\n      box.max.subtract\(box.min\).length /\r\n      \(camera.projectionType == camera.TYPE_ORTHOGRAPHIC ? factor : 0.75 * Math.tan\(camera.fov\)\);\r\n    if \(r < 0.001\) return;\r\n    var viewDir = camera.targetPosition.subtract\(camera.position\);\r\n    if \(camera.projectionType != camera.TYPE_ORTHOGRAPHIC\) {\r\n      viewDir.normalize\(\);\r\n      viewDir.scaleInPlace\(r\);\r\n    }\r\n    camera.targetPosition.set\(box.center\);\r\n    camera.position.set\(box.center.subtract\(viewDir\)\);\r\n    camera.up.set\(camera.position.add\(upVec\)\);\r\n    camera.viewPlaneSize = r * factor * 1.2; // 1.2 fudge\r\n  };\r\n\r\n  this.findPrevious = function \(document, newText\) {\r\n    this.findBackwards = true;\r\n    if \(this.findIndex > 0\) this.findFromIndex\(document, this.findText, this.findIndex - 1\);\r\n  };\r\n\r\n  this.findNext = function \(document, newText\) {\r\n    this.findBackwards = false;\r\n    if \(this.findIndex < this.bomListOccurrenceIds.length\)\r\n      this.findFromIndex\(document, this.findText, this.findIndex + 1\);\r\n  };\r\n\r\n  this.findFromIndex = function \(document, newText, findIndex\) {\r\n    if \(typeof newText !== 'string'\) return;\r\n    if \(newText == ''\) return;\r\n    var compId, i, component;\r\n    var found = false;\r\n    this.findText = newText;\r\n    var startIndex = 0;\r\n    if \(findIndex\) startIndex = findIndex;\r\n    var endIndex = this.bomListOccurrenceIds.length;\r\n    if \(this.findBackwards\) endIndex = -1;\r\n    for \(i = startIndex; i !== endIndex; \) {\r\n      var rowText = this.bomListBox.getItemAt\(i, false\);\r\n      if \(rowText.toLowerCase\(\).indexOf\(newText.toLowerCase\(\)\) != -1\) {\r\n        this.selectedBomIndex = i;\r\n        var occIdArray = this.bomListOccurrenceIds[this.selectedBomIndex];\r\n        if \(occIdArray.length > 0\) this.bomHighlight\(document, occIdArray[0]\);\r\n        else this.bomListBox.currentValueIndices = this.selectedBomIndex;\r\n        this.findIndex = i;\r\n        return true;\r\n      }\r\n      i += this.findBackwards ? -1 : 1;\r\n    }\r\n    return false;\r\n  };\r\n\r\n  this.find = function \(document, newText, findIndex\) {\r\n    var found = this.findFromIndex\(document, newText, findIndex\);\r\n    if \(!found\) {\r\n      this.highlightAllOccurrences\(document, -1, false\);\r\n      this.selectedOccurrenceId = null;\r\n    }\r\n  };\r\n\r\n  this.setCameraToCannedView = function \(document, canned\) {\r\n    var a3d = getA3d\(document\);\r\n    if \(!a3d\) {\r\n      return;\r\n    }\r\n    var c3d = a3d.context3D;\r\n    var scene = getScene\(document\);\r\n    if \(!scene\) {\r\n      return;\r\n    }\r\n\r\n    var dir = new c3d.Vector3\(\);\r\n    var up = new c3d.Vector3\(\);\r\n\r\n    if \(canned === 'FRONT'\) {\r\n      dir.set\(0, 0, -1\);\r\n      up.set\(0, 1, 0\);\r\n    } else if \(canned === 'BOTTOM'\) {\r\n      dir.set\(0, 1, 0\);\r\n      up.set\(0, 0, -1\);\r\n    } else if \(canned === 'LEFT'\) {\r\n      dir.set\(1, 0, 0\);\r\n      up.set\(0, 1, 0\);\r\n    } else if \(canned === 'RIGHT'\) {\r\n      dir.set\(-1, 0, 0\);\r\n      up.set\(0, 1, 0\);\r\n    } else if \(canned === 'BACK'\) {\r\n      dir.set\(0, 0, 1\);\r\n      up.set\(0, 1, 0\);\r\n    } else if \(canned === 'TOP'\) {\r\n      dir.set\(0, -1, 0\);\r\n      up.set\(0, 0, -1\);\r\n    } else if \(canned === 'ISO'\) {\r\n      dir.set\(1, -1, -1\);\r\n      up.set\(0, 1, 0\);\r\n    } else {\r\n      console.println\('unrecognized view: ' + canned\);\r\n      return;\r\n    }\r\n    var camera = scene.cameras.getByIndex\(0\);\r\n    var len = camera.targetPosition.subtract\(camera.position\).length;\r\n    camera.position.set\(camera.targetPosition.subtract\(dir.scale\(len\)\)\);\r\n    camera.up.set\(camera.position.add\(up\)\);\r\n    this.zoom\(document\);\r\n  };\r\n\r\n  this.undoLastView = function \(document\) {\r\n    if \(document.selectedViewId\) {\r\n      selectViewById\(document, document.selectedViewId, true\);\r\n    }\r\n  };\r\n\r\n  this.hideSelected = function \(document\) {\r\n    this.lastSelectedOccurrenceId = this.selectedOccurrenceId;\r\n    this.hideShowSelected\(document, false\);\r\n  };\r\n\r\n  this.showSelected = function \(document\) {\r\n    if \(this.lastSelectedOccurrenceId\) this.selectedOccurrenceId = this.lastSelectedOccurrenceId;\r\n    this.hideShowSelected\(document, true\);\r\n    this.lastSelectedOccurrenceId = 0;\r\n  };\r\n\r\n  this.hideShowSelected = function \(document, visible\) {\r\n    var mesh, i, scene;\r\n    scene = getScene\(document\);\r\n    if \(!scene\) {\r\n      return;\r\n    }\r\n    for \(i = 0; i < scene.meshes.count; i += 1\) {\r\n      mesh = scene.meshes.getByIndex\(i\);\r\n      var parentNode = mesh.parent;\r\n      if \(this.nodeNameToIndexMap[parentNode.name] == this.selectedBomIndex\) {\r\n        if \(mesh.visible !== visible\) {\r\n          mesh.visible = visible;\r\n        }\r\n      }\r\n    }\r\n  };\r\n\r\n  this.zoomSelectedNode = function \(document\) {\r\n    var scene;\r\n    scene = getScene\(document\);\r\n    if \(!scene\) {\r\n      return;\r\n    }\r\n    if \(scene.selectedNode\) {\r\n      var camera = scene.cameras.getByIndex\(0\);\r\n      var center = this.getNodeCenterPoint\(document, scene.selectedNode\);\r\n      if \(center\) {\r\n        var viewDir = camera.targetPosition.subtract\(camera.position\);\r\n        var upVec = camera.up.subtract\(camera.position\);\r\n        if \(camera.projectionType != camera.TYPE_ORTHOGRAPHIC\) {\r\n          viewDir.normalize\(\);\r\n          viewDir.scaleInPlace\(r\);\r\n        }\r\n        camera.targetPosition.set\(center\);\r\n        camera.position.set\(center.subtract\(viewDir\)\);\r\n        camera.up.set\(camera.position.add\(upVec\)\);\r\n      }\r\n    }\r\n  };\r\n\r\n  this.getNodeCenterPoint = function \(document, node\) {\r\n    var bbox, mesh, i;\r\n    if \(node\) {\r\n      if \(node.computeBoundingBox\) {\r\n        var a3d = getA3d\(document\);\r\n        if \(!a3d\) return undefined;\r\n        var c3d = a3d.context3D;\r\n        var bbox = node.computeBoundingBox\(\);\r\n        var center = bbox.center;\r\n        var nodeParent = node;\r\n        var transMatrix = new c3d.Matrix4x4\(\);\r\n        while \(nodeParent && nodeParent.transform\) {\r\n          center = nodeParent.transform.transformPosition\(center\);\r\n          nodeParent = nodeParent.parent;\r\n        }\r\n        return center;\r\n      }\r\n    }\r\n    return undefined;\r\n  };\r\n\r\n  this.isolate = function \(document\) {\r\n    var mesh, i, scene, mustShow;\r\n    scene = getScene\(document\);\r\n    if \(!scene || !this.nodeNameToOccurrenceIdMap || !this.selectedOccurrenceId\) {\r\n      return;\r\n    }\r\n    for \(i = 0; i < scene.meshes.count; i++\) {\r\n      mustShow = false;\r\n      mesh = scene.meshes.getByIndex\(i\);\r\n      var parentNode = mesh.parent;\r\n      if \(this.nodeNameToOccurrenceIdMap[parentNode.name]\) {\r\n        mustShow = this.nodeNameToIndexMap[parentNode.name] == this.selectedBomIndex;\r\n      }\r\n      if \(mustShow && !mesh.visible\) {\r\n        mesh.visible = true;\r\n      } else if \(!mustShow && mesh.visible\) {\r\n        mesh.visible = false;\r\n      }\r\n    }\r\n  };\r\n\r\n  // show all mesh nodes except PMI and datum\r\n  this.showAll = function \(document\) {\r\n    var mesh, i, scene;\r\n    scene = getScene\(document\);\r\n    if \(!scene\) {\r\n      return;\r\n    }\r\n    for \(i = 0; i < scene.meshes.count; i++\) {\r\n      mesh = scene.meshes.getByIndex\(i\);\r\n      if \(this.nodeNameToOccurrenceIdMap[mesh.parent.name]\) {\r\n        mesh.visible = true;\r\n      }\r\n    }\r\n    var camera = scene.cameras.getByIndex\(0\);\r\n    var upVec = camera.up.subtract\(camera.position\);\r\n    var box = scene.computeBoundingBox\(\);\r\n    var factor = 1.7320508075688772935274463415059; //sqrt\(3\)\r\n    var r =\r\n      box.max.subtract\(box.min\).length /\r\n      \(camera.projectionType == camera.TYPE_ORTHOGRAPHIC ? factor : 0.75 * Math.tan\(camera.fov\)\);\r\n    var viewDir = camera.targetPosition.subtract\(camera.position\);\r\n    viewDir.normalize\(\);\r\n    viewDir.scaleInPlace\(r\);\r\n\r\n    camera.position.set\(camera.targetPosition.subtract\(viewDir\)\);\r\n    camera.up.set\(camera.position.add\(upVec\)\);\r\n  };\r\n\r\n  this.highlightAllOccurrences = function \(document, index, isHighlight\) {\r\n    var scene, mesh, i, needsHighlight;\r\n    scene = getScene\(document\);\r\n    if \(!scene || !this.nodeNameToOccurrenceIdMap\) {\r\n      return;\r\n    }\r\n    var occIdArray = [];\r\n    if \(index !== -1\) occIdArray = this.bomListOccurrenceIds[index];\r\n    if \(isHighlight\) scene.defaultRenderOptions.illustrationRenderModeFaceColor.set\(1, 0, 0\);\r\n    else scene.defaultRenderOptions.illustrationRenderModeFaceColor.set\(1, 1, 1\);\r\n    for \(i = 0; i < scene.meshes.count; i++\) {\r\n      mesh = scene.meshes.getByIndex\(i\);\r\n      var parentNode = mesh.parent;\r\n      if \(this.nodeNameToOccurrenceIdMap[parentNode.name]\) {\r\n        // just include meshes that belong to parts \(i.e. do not include fill font meshes belonging to GD&T\)\r\n        needsHighlight = this.nodeNameToIndexMap[parentNode.name] === index;\r\n        if \(needsHighlight && isHighlight\) {\r\n          mesh.renderMode = 'illustration';\r\n          mesh.opacity = 0.99; // try to preserve edges\r\n        } else {\r\n          if \(isHighlight && mesh.renderMode !== 'transparent'\) {\r\n            mesh.renderMode = 'transparent';\r\n          } else if \(!isHighlight && mesh.renderMode !== 'solid outline'\) {\r\n            mesh.renderMode = 'solid outline';\r\n            mesh.opacity = 1.0;\r\n          }\r\n        }\r\n      }\r\n    }\r\n  };\r\n\r\n  this.bomHighlight = function \(document, selOccId\) {\r\n    this.createSelectionLookups\(document\);\r\n    var index;\r\n    index = this.bomOccurrenceIdToIndex[selOccId];\r\n    if \(index === undefined\) {\r\n      index = -1;\r\n    }\r\n    if \(index !== -1\) this.bomListBox.currentValueIndices = index;\r\n    this.selectedBomIndex = index;\r\n    this.selectedOccurrenceId = selOccId;\r\n    this.populateBOMFields\(document\);\r\n    this.highlightAllOccurrences\(document, index, true\);\r\n  };\r\n\r\n  this.selectItemFromBOM = function \(document, index\) {\r\n    var scene = getScene\(document\);\r\n    if \(index !== -1\) {\r\n      this.createSelectionLookups\(document\);\r\n      if \(!scene\) {\r\n        return;\r\n      }\r\n      this.selectedBomIndex = index;\r\n      var occIdArray = this.bomListOccurrenceIds[this.selectedBomIndex];\r\n      if \(occIdArray.length > 0\) {\r\n        var selOccId = occIdArray[0];\r\n        if \(this.occurrenceIdToNodeMap[selOccId]\)\r\n          scene.selectedNode = this.occurrenceIdToNodeMap[selOccId];\r\n        else scene.selectedNode = undefined;\r\n      } else scene.selectedNode = undefined;\r\n    } else scene.selectedNode = undefined;\r\n  };\r\n\r\n  this.createSelectionLookups = function \(document\) {\r\n    var scene, i, node, cadEntityId, entity, a3d, c3d, occId, thermometer, selectionHandler;\r\n    scene = getScene\(document\);\r\n    if \(!scene\) {\r\n      return;\r\n    }\r\n    if \(this.createdSelectionLookups === true\) {\r\n      return;\r\n    }\r\n    this.createdSelectionLookups = true;\r\n\r\n    // set the initial default view\r\n    if \(setInitialView\) {\r\n      setInitialView\(document\);\r\n    }\r\n    this.occurrenceIdToNodeMap = {};\r\n    this.nodeNameToOccurrenceIdMap = {};\r\n\r\n    if \(scene.renderMode !== 'solid outline'\) {\r\n      scene.renderMode = 'solid outline';\r\n    }\r\n\r\n    thermometer = app.thermometer; // acquire a thermometer object\r\n    thermometer.duration = scene.nodes.count;\r\n    thermometer.begin\(\);\r\n\r\n    // create a reference between a scene node and its cadEntityId\r\n    for \(i = 0; i < scene.nodes.count; i++\) {\r\n      thermometer.value = i;\r\n      thermometer.text = 'Initializing ' + \(i + 1\);\r\n      if \(thermometer.cancelled\) break;\r\n      node = scene.nodes.getByIndex\(i\);\r\n      if \(node.metadataString\) {\r\n        cadEntityId = getCadEntityIdFromMetadataString\(node.metadataString\);\r\n        if \(cadEntityId\) {\r\n          node.cadEntityId = cadEntityId;\r\n          entity = document.anarkCoreData.getEntityById\(cadEntityId\);\r\n          if \(entity\) {\r\n            if \(\r\n              entity.typeOfEntity === 'PartOccurrence' ||\r\n              entity.typeOfEntity === 'AssemblyOccurrence'\r\n            \) {\r\n              occId = entity.cadEntityId;\r\n              this.occurrenceIdToNodeMap[occId] = node;\r\n              this.nodeNameToOccurrenceIdMap[node.name] = occId;\r\n            }\r\n          }\r\n        }\r\n      }\r\n    }\r\n    thermometer.end\(\);\r\n\r\n    // create selection event handler\r\n    a3d = getA3d\(document\);\r\n    c3d = a3d.context3D;\r\n    selectionHandler = new c3d.SelectionEventHandler\(\);\r\n    selectionHandler.owner = this;\r\n    selectionHandler.onEvent = function \(event\) {\r\n      document.akBom.selectionEventCallback\(document, event\);\r\n    };\r\n    c3d.runtime.addEventHandler\(selectionHandler\);\r\n\r\n    // accellerate selections\r\n    thermometer = app.thermometer; // acquire a thermometer object\r\n    thermometer.duration = scene.meshes.count;\r\n    thermometer.begin\(\);\r\n    this.nodeNameToIndexMap = {};\r\n    for \(i = 0; i < scene.meshes.count; i++\) {\r\n      thermometer.value = i;\r\n      thermometer.text = 'Optimizing ' + \(index + 1\) + ' of ' + scene.meshes.count;\r\n      if \(thermometer.cancelled\) break;\r\n      var mesh = scene.meshes.getByIndex\(i\);\r\n      var parentNode = mesh.parent;\r\n      if \(this.nodeNameToOccurrenceIdMap[parentNode.name]\) {\r\n        // just consider meshes that belong to parts\r\n        var index = this.findAncestorOccurrenceIndex\(parentNode\);\r\n        if \(index >= 0\) this.nodeNameToIndexMap[parentNode.name] = index;\r\n      }\r\n    }\r\n    thermometer.end\(\);\r\n  };\r\n\r\n  this.findAncestorOccurrenceIndex = function \(node\) {\r\n    var n = node;\r\n    while \(n.parent\) {\r\n      var occId = this.nodeNameToOccurrenceIdMap[n.name];\r\n      var index = this.bomOccurrenceIdToIndex[occId];\r\n      if \(index !== undefined\) {\r\n        return index;\r\n      }\r\n      n = n.parent;\r\n    }\r\n    return -1;\r\n  };\r\n\r\n  this.isBomField = function \(field\) {\r\n    // BOM fields may be prefixed with "bom" to help separate them from top-level Acroform fields\r\n    return stringStartsWith\(field.name, 'bom_'\);\r\n  };\r\n\r\n  // populate BOM fields using a name-matching scheme\r\n  this.populateBOMFields = function \(document\) {\r\n    for \(var i = 0; i < document.numFields; i++\) {\r\n      var fname = document.getNthFieldName\(i\);\r\n      var field = document.getField\(fname\);\r\n      if \(this.isBomField\(field\)\) {\r\n        this.bindBOMFieldToAttributeByMatchingName\(document, field\);\r\n      }\r\n    }\r\n    if \(this.selectedOccurrenceId === null\) {\r\n      this.clearBomListBoxSelection\(\);\r\n    }\r\n  };\r\n\r\n  this.clearBomListBoxSelection = function \(\) {\r\n    try {\r\n      this.bomListBox.insertItemAt\(0, 0, 0\); // hack to unselect list\r\n      this.bomListBox.deleteItemAt\(0\);\r\n    } catch \(e\) {\r\n      // 10.1.8 throws a NotAllowedError exception if insertItemAt is called from a Open notification event\r\n    }\r\n  };\r\n\r\n  this.bindBOMFieldToAttributeByMatchingName = function \(document, textEditField\) {\r\n    var componentAttributes, found;\r\n    if \(this.selectedOccurrenceId === null\) {\r\n      textEditField.value = '';\r\n    } else {\r\n      var index = this.bomOccurrenceIdToIndex[this.selectedOccurrenceId];\r\n      if \(index !== undefined && index !== -1\) {\r\n        var occIdArray = this.bomListOccurrenceIds[index];\r\n        for \(var j = 0; j < occIdArray.length; j++\) {\r\n          var compId = document.anarkCoreData.getEntityById\(occIdArray[j]\).componentId;\r\n          componentAttributes = document.anarkCoreData.getAttributesInOriginalOrder\(\r\n            document.anarkCoreData.getEntityById\(compId\)\r\n          \);\r\n          found = populateFieldIfAttributeMatchesName\(document, textEditField, componentAttributes\);\r\n          if \(found\) return;\r\n        }\r\n      }\r\n      textEditField.value = '';\r\n    }\r\n  };\r\n}\r\n// ANARKCOREDATA_BEGIN data-ac-json-requirement="All" data-ac-format-version="3" data-ac-image-width="1600" data-ac-image-height="1200" data-ac-image-background="#FFFFFF" data-ac-3dview-color="#FFFFFF"\rvar data;\r\n/**\r\n * The main Anark JavaScript API object providing various data and functionality.\r\n * Copyright 2007-2019 Anark Corporation. All rights reserved..\r\n * @constructor\r\n * @param {bool} buildOccurrenceStructure - Optional. If true, this will provide an occurrence tree structure to use \(adds parent/child object references to the occurrences\).\r\n * @param {bool} enableProcessPlanning - Optional. If true, this will create additional objects to assist with process planning data access, specifically the processPlanning property \(see {@link ProcessPlanning}\).\r\n */\r\nfunction ANARKCOREDATA\(buildOccurrenceStructure, enableProcessPlanning, publishedData\) {\r\n    "use strict";\r\n    if \(publishedData == undefined\) {\r\n        this.product =  {"Workspace": {"name":"","cadEntityId":100,"typeOfEntity":"Workspace","Attributes": {"AnarkCoreVersion":"4.6.3.23400","Current Date\\/Time":"3\\/20\\/2026","Local Time":"2:36:20 PM","Project Descr